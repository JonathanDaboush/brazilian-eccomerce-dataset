# MySQL (secret values: yes)
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=ecommerce_data_set
MYSQL_USER=user
MYSQL_PASSWORD=changeme-user
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Kafka (non-secret)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=olist-orders-events
KAFKA_CONSUMER_GROUP=olist-replay-consumer

# Airflow metadata DB (secret values: yes)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow UI admin user (secret values: yes)
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=admin@example.com

# Optional health probe URL used by FastAPI (non-secret)
AIRFLOW_HEALTH_URL=http://airflow-webserver:8080/health
